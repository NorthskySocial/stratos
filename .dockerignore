# Dependencies
# Use **/ so nested workspace node_modules are excluded too. A bare
# `node_modules/` only matches the context root, which let host
# package manager symlinks (e.g. Deno's .deno store) leak into the
# image and dangle, breaking module resolution at build time.
**/node_modules/
.pnpm-store/

# Build outputs (rebuilt in container)
dist/
*.js
*.d.ts
*.js.map

# Development
.git/
.github/
.vscode/
*.log
*.local

# Test files
coverage/
.nyc_output/
*.test.ts
tests/

# Documentation (not needed at runtime)
docs/
*.md
!README.md

# Docker files
Dockerfile

# CDK
infra/cdk.out/
docker-compose*.yml
.dockerignore

# Environment files (use docker-compose environment instead)
.env
.env.*
!.env.example

# macOS
.DS_Store
*.swp
*.swo

# IDE
.idea/
*.iml

# Temporary files
tmp/
temp/
