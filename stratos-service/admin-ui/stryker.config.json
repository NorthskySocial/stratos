{
  "$schema": "../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "vitest": { "configFile": "vitest.config.ts" },
  "inPlace": true,
  "reporters": ["clear-text", "json"],
  "mutate": [
    "src/lib/boundary-form.ts",
    "src/lib/api/boundary-catalog.ts",
    "src/lib/api/client.ts:85:0-95:0",
    "src/lib/api/client.ts:121:0-170:0"
  ],
  "incremental": false,
  "concurrency": 2,
  "thresholds": { "high": 80, "low": 60, "break": 60 }
}
