{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "vitest": {
    "configFile": "vitest.request-proof.config.mjs"
  },
  "inPlace": true,
  "reporters": ["clear-text", "json"],
  "mutate": ["src/infra/auth/request-proof-foundation.ts"],
  "incremental": false,
  "concurrency": 4,
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 60
  },
  "jsonReporter": {
    "fileName": "reports/request-proof/mutation.json"
  }
}
