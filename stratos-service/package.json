{
  "name": "@northskysocial/stratos-service",
  "version": "0.3.0",
  "description": "Standalone Stratos private namespace service for ATProtocol",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "stratos": "./dist/bin/stratos.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && pnpm run build:admin",
    "build:admin": "vite build --config admin-ui/vite.config.ts",
    "dev:admin": "vite --config admin-ui/vite.config.ts",
    "clean": "rm -rf dist",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "mutation": "stryker run",
    "format": "prettier --write .",
    "lint": "eslint --ext .ts .",
    "generate:version": "tsx scripts/generate-version.ts"
  },
  "dependencies": {
    "@atcute/atproto": "^4.0.4",
    "@atcute/car": "^6.0.2",
    "@atcute/cbor": "^2.3.6",
    "@atcute/cid": "^2.4.2",
    "@atcute/client": "^5.1.1",
    "@atcute/mst": "^1.0.3",
    "@atcute/repo": "^1.0.2",
    "@atcute/uint8array": "^1.1.5",
    "@atproto/api": "^0.20.41",
    "@atproto/aws": "^0.3.14",
    "@atproto/common": "^0.8.0",
    "@atproto/common-web": "^0.5.9",
    "@atproto/crypto": "^0.5.4",
    "@atproto/did": "^0.5.4",
    "@atproto/identity": "^0.5.9",
    "@atproto/jwk-jose": "^0.2.4",
    "@atproto/lex-cbor": "^0.1.6",
    "@atproto/lex-data": "^0.1.7",
    "@atproto/lexicon": "^0.7.11",
    "@atproto/oauth-client-node": "^0.5.3",
    "@atproto/oauth-provider": "^0.22.3",
    "@atproto/oauth-types": "^0.7.5",
    "@atproto/syntax": "^0.7.4",
    "@atproto/xrpc-server": "^0.12.5",
    "@ipld/dag-cbor": "^9.2.5",
    "@libsql/client": "^0.17.0",
    "@northskysocial/stratos-core": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "1.0.0-beta.18-7eb39f0",
    "express": "^5.2.1",
    "ioredis": "^5.5.0",
    "jose": "^6.1.3",
    "jsonwebtoken": "^9.0.3",
    "multiformats": "^13.4.2",
    "pino": "^10.3.0",
    "pino-http": "^11.0.0",
    "postgres": "^3.4.8",
    "tsx": "^4.21.0",
    "ws": "^8.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@atcute/cbor": "^2.3.6",
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/vite": "^4.1.0",
    "@testcontainers/postgresql": "^11.12.0",
    "@tsconfig/svelte": "^5.0.4",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.2.1",
    "@types/ws": "^8.18.1",
    "axios": "^1.14.0",
    "eslint": "^10.0.0",
    "fast-check": "^4.5.0",
    "globals": "^17.3.0",
    "svelte": "^5.20.0",
    "svelte-spa-router": "^5.1.1",
    "tailwindcss": "^4.1.0",
    "testcontainers": "^11.12.0",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "vite": "^6.1.0",
    "vitest": "^4.0.18"
  },
  "files": [
    "dist",
    "src"
  ],
  "license": "MIT"
}
