{
  "name": "@northskysocial/stratos-service",
  "version": "1.0.0",
  "description": "Standalone Stratos private namespace service for ATProtocol",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "stratos": "./dist/bin/stratos.js",
    "stratos-rotate-service-key": "./dist/bin/rotate-service-key.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && pnpm run build:admin",
    "build:admin": "vite build --config admin-ui/vite.config.ts",
    "dev:admin": "vite --config admin-ui/vite.config.ts",
    "clean": "rm -rf dist",
    "start": "node --enable-source-maps --import ./dist/observability/instrumentation.js dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "mutation": "stryker run",
    "format": "prettier --write .",
    "lint": "eslint --ext .ts .",
    "generate:version": "tsx scripts/generate-version.ts"
  },
  "dependencies": {
    "@atcute/atproto": "^4.0.5",
    "@atcute/cbor": "^2.3.8",
    "@atcute/car": "^6.1.1",
    "@atcute/cid": "^2.5.0",
    "@atcute/client": "^5.1.2",
    "@atcute/mst": "^1.1.1",
    "@atcute/repo": "^1.1.1",
    "@atcute/uint8array": "^1.2.1",
    "@atproto/api": "^0.32.7",
    "@atproto/aws": "^0.3.27",
    "@atproto/common": "^0.8.13",
    "@atproto/common-web": "^0.5.20",
    "@atproto/crypto": "^0.5.8",
    "@atproto/did": "^0.5.6",
    "@atproto/identity": "^0.5.27",
    "@atproto/jwk-jose": "^0.2.4",
    "@atproto/lex-cbor": "^0.1.11",
    "@atproto/lex-data": "^0.1.11",
    "@atproto/lexicon": "^0.7.22",
    "@atproto/oauth-client-node": "^0.5.21",
    "@atproto/oauth-provider": "^0.27.3",
    "@atproto/oauth-scopes": "0.0.0-spaces-alpha-20261124235736",
    "@atproto/oauth-types": "^0.8.0",
    "@atproto/syntax": "^0.7.9",
    "@atproto/xrpc-server": "^0.13.17",
    "@ipld/dag-cbor": "^11.0.0",
    "@libsql/client": "^0.18.0",
    "@northskysocial/stratos-client": "workspace:*",
    "@northskysocial/stratos-core": "workspace:*",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.301.2",
    "@opentelemetry/instrumentation-runtime-node": "^0.38.0",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-metrics": "^3.1.1",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "@sentry/node": "^11.19.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "1.0.0-rc.6",
    "express": "^5.3.0",
    "ioredis": "^6.1.0",
    "jose": "^6.2.18",
    "jsonwebtoken": "^9.0.3",
    "multiformats": "^14.0.8",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "postgres": "^4.1.1",
    "structured-headers": "2.1.1",
    "tsx": "^4.23.15",
    "ws": "^8.23.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@atcute/cbor": "^2.3.8",
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.2",
    "@tailwindcss/vite": "^4.3.5",
    "@testcontainers/postgresql": "^12.2.2",
    "@tsconfig/svelte": "^5.0.9",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.11",
    "@types/ws": "^8.18.2",
    "axios": "^1.21.1",
    "eslint": "^10.15.0",
    "fast-check": "^4.11.0",
    "globals": "^17.14.0",
    "svelte": "^5.59.2",
    "svelte-spa-router": "^5.1.1",
    "tailwindcss": "^4.3.5",
    "testcontainers": "^12.2.2",
    "tsc-alias": "^1.9.11",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@~6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  },
  "files": [
    "dist",
    "src"
  ],
  "license": "MIT"
}
