{
  "lexicon": 1,
  "id": "zone.stratos.admin.addAdmin",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Grant admin access to a DID. Requires admin authorization.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["did"],
          "properties": {
            "did": {
              "type": "string",
              "format": "did",
              "description": "The DID to grant admin access to."
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["did"],
          "properties": {
            "did": { "type": "string", "format": "did" }
          }
        }
      }
    }
  }
}
