{
  "name": "@northskysocial/stratos-feedgen",
  "version": "0.3.2",
  "private": true,
  "description": "Standalone Stratos feed generator",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "stratos-feedgen": "dist/bin/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "bundle": "node scripts/bundle.mjs",
    "clean": "rm -rf dist dist-bundle",
    "start": "node --enable-source-maps --import ./dist/observability/instrumentation.js dist/bin/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "mutation": "stryker run",
    "format": "prettier --write .",
    "lint": "eslint --ext .ts ."
  },
  "dependencies": {
    "@atcute/cbor": "^2.3.8",
    "@atproto/crypto": "^0.5.8",
    "@atproto/identity": "^0.5.27",
    "@atproto/lexicon": "^0.7.22",
    "@atproto/xrpc-server": "^0.13.17",
    "@libsql/client": "^0.18.0",
    "@noble/hashes": "^2.4.0",
    "@northskysocial/stratos-core": "workspace:*",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.301.2",
    "@opentelemetry/instrumentation-runtime-node": "^0.38.0",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-metrics": "^3.1.1",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "@sentry/node": "^11.19.0",
    "drizzle-orm": "1.0.0-rc.6",
    "express": "^5.3.0",
    "pino": "^10.4.0",
    "postgres": "^4.1.1",
    "undici": "^8.13.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@testcontainers/postgresql": "^12.2.2",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.11",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "typescript": "npm:@typescript/typescript6@~6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "vitest": "^5.1.2",
    "ws": "^8.23.0"
  }
}
