{
  "name": "@northskysocial/stratos-feedgen",
  "version": "0.3.1",
  "private": true,
  "description": "Standalone Stratos feed generator",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "stratos-feedgen": "dist/bin/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "bundle": "node scripts/bundle.mjs",
    "clean": "rm -rf dist dist-bundle",
    "start": "node --enable-source-maps --import ./dist/observability/instrumentation.js dist/bin/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "mutation": "stryker run",
    "format": "prettier --write .",
    "lint": "eslint --ext .ts ."
  },
  "dependencies": {
    "@atcute/cbor": "^2.3.6",
    "@atproto/crypto": "^0.5.4",
    "@atproto/identity": "^0.5.9",
    "@atproto/lexicon": "^0.7.11",
    "@atproto/xrpc-server": "^0.12.5",
    "@libsql/client": "^0.17.0",
    "@noble/hashes": "^1.6.1",
    "@northskysocial/stratos-core": "workspace:*",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.222.0",
    "@opentelemetry/instrumentation-runtime-node": "^0.35.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@sentry/node": "^10.73.0",
    "drizzle-orm": "1.0.0-beta.18-7eb39f0",
    "express": "^4.21.2",
    "pino": "^10.3.0",
    "postgres": "^3.4.8",
    "undici": "^7.27.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@testcontainers/postgresql": "^11.12.0",
    "@types/express": "^4.17.21",
    "@types/node": "^25.2.1",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.0",
    "typescript": "npm:@typescript/typescript6@~6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "vitest": "^4.0.18",
    "ws": "^8.19.0"
  }
}
