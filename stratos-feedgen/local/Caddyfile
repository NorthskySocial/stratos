# Caddy sidecar for local feedgen testing.
#
# Two jobs:
#   1. Serve the feed gen's did:web document at /.well-known/did.json so the
#      user's PDS and Stratos can resolve `did:web:<ngrok-host>`.
#   2. Reverse-proxy XRPC (and /health) to the feedgen Node service.
#
# ngrok points at THIS sidecar (port 8080), not at feedgen directly, so that
# the did document and the XRPC endpoint share one public origin. The feedgen
# service code stays untouched (it has no static-file route).

{
	admin off
	auto_https off
}

:8080 {
	handle /.well-known/did.json {
		header Content-Type application/json
		root * /srv
		rewrite * /did.json
		file_server
	}

	handle {
		reverse_proxy feedgen:3000
	}
}
