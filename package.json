{
  "name": "stratos",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Stratos - Private namespace service for ATProtocol",
  "repository": {
    "type": "git",
    "url": "https://github.com/NorthskySocial/stratos.git"
  },
  "license": "MIT",
  "scripts": {
    "build": "pnpm -r run build",
    "clean": "pnpm -r run clean",
    "lint": "pnpm -r run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:spaces-alignment": "vitest run --config test/spaces-alignment/vitest.config.ts",
    "mutation": "pnpm -r run mutation",
    "codegen": "pnpm --filter @northskysocial/stratos-client run lexgen",
    "dev:local": "tsx scripts/dev-local.ts",
    "dev:local:debug": "tsx scripts/dev-local.ts --debug-service",
    "e2etest": "deno run -A test/scripts/run-all.ts",
    "e2etestappview": "deno run -A test/scripts/run-all.ts --appview",
    "test:integration": "pnpm e2etest",
    "test:integration:appview": "pnpm e2etestappview"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/deno": "^2.7.0",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@~6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@vitest/coverage-v8": "^5.1.1",
    "dotenv": "^18.0.10"
  }
}
