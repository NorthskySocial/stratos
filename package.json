{
  "name": "stratos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Stratos - Private namespace service for ATProtocol",
  "repository": {
    "type": "git",
    "url": "https://github.com/NorthskySocial/stratos.git"
  },
  "license": "MIT",
  "scripts": {
    "build": "pnpm -r run build",
    "clean": "pnpm -r run clean",
    "lint": "pnpm -r run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "mutation": "pnpm -r run mutation",
    "codegen": "pnpm --filter @northskysocial/stratos-client run lexgen",
    "dev:local": "tsx scripts/dev-local.ts",
    "dev:local:debug": "tsx scripts/dev-local.ts --debug-service",
    "e2etest": "deno run -A test/scripts/run-all.ts",
    "e2etestappview": "deno run -A test/scripts/run-all.ts --appview",
    "test:integration": "pnpm e2etest",
    "test:integration:appview": "pnpm e2etestappview"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ngrok/ngrok": "^1.7.0",
    "@types/deno": "^2.5.0",
    "@types/node": "^25.2.1",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "concurrently": "^9.2.1",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.3.0",
    "jsdom": "^29.0.2",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "npm:@typescript/typescript6@~6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@vitest/coverage-v8": "^4.0.18",
    "dotenv": "^17.4.0"
  }
}
