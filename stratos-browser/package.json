{
  "name": "@northskysocial/stratos-browser",
  "version": "1.0.0",
  "description": "Browser OAuth and DPoP helpers for Stratos applications",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "test": "vitest run --config vitest.config.ts",
    "mutation": "stryker run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prelint": "pnpm --filter @northskysocial/stratos-client run build",
    "lint": "eslint ."
  },
  "dependencies": {
    "@atproto/api": "^0.32.7",
    "@atproto/lexicon": "^0.7.22",
    "@atproto/oauth-client-browser": "^0.5.19",
    "@atproto/oauth-types": "^0.8.0",
    "@northskysocial/stratos-client": "workspace:*"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "typescript": "npm:@typescript/typescript6@~6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "vitest": "^5.1.2"
  }
}
