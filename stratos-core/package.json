{
  "name": "@northskysocial/stratos-core",
  "version": "0.3.2",
  "description": "Shared library for Stratos private namespace service",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./atproto": {
      "types": "./src/atproto/index.ts",
      "import": "./src/atproto/index.ts"
    },
    "./validation": {
      "types": "./src/validation/index.ts",
      "import": "./src/validation/index.ts"
    },
    "./db": {
      "types": "./src/db/index.ts",
      "import": "./src/db/index.ts"
    },
    "./db/pg": {
      "types": "./src/db/pg.ts",
      "import": "./src/db/pg.ts"
    },
    "./enrollment": {
      "types": "./src/enrollment/index.ts",
      "import": "./src/enrollment/index.ts"
    },
    "./spaces": {
      "types": "./src/spaces/index.ts",
      "import": "./src/spaces/index.ts"
    },
    "./network": {
      "types": "./src/network/index.ts",
      "import": "./src/network/index.ts"
    },
    "./tests": {
      "types": "./tests/utils/index.ts",
      "import": "./tests/utils/index.ts"
    },
    "./boundary/types": {
      "types": "./src/boundary/types.ts",
      "import": "./src/boundary/types.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "mutation": "stryker run",
    "format": "prettier --write .",
    "lint": "eslint --ext .ts ."
  },
  "dependencies": {
    "@atcute/atproto": "^4.0.5",
    "@atcute/car": "^6.1.1",
    "@atcute/cbor": "^2.3.8",
    "@atcute/cid": "^2.5.0",
    "@atcute/client": "^5.1.2",
    "@atcute/mst": "^1.1.1",
    "@atcute/uint8array": "^1.2.1",
    "@atproto-labs/fetch": "^0.4.3",
    "@atproto/common-web": "^0.5.19",
    "@atproto/identity": "^0.5.25",
    "@atproto/lex-cbor": "^0.1.11",
    "@atproto/lex-data": "^0.1.11",
    "@atproto/lexicon": "^0.7.21",
    "@atproto/syntax": "^0.7.9",
    "@libsql/client": "^0.18.0",
    "drizzle-orm": "1.0.0-beta.18-7eb39f0",
    "ipaddr.js": "^2.5.0",
    "multiformats": "^14.0.6",
    "postgres": "^4.1.1",
    "undici": "^8.13.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.3",
    "globals": "^17.14.0",
    "tsc-alias": "^1.9.10",
    "typescript": "npm:@typescript/typescript6@~6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "files": [
    "dist",
    "src"
  ],
  "license": "MIT",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/",
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./atproto": {
        "types": "./dist/atproto/index.d.ts",
        "import": "./dist/atproto/index.js"
      },
      "./validation": {
        "types": "./dist/validation/index.d.ts",
        "import": "./dist/validation/index.js"
      },
      "./db": {
        "types": "./dist/db/index.d.ts",
        "import": "./dist/db/index.js"
      },
      "./db/pg": {
        "types": "./dist/db/pg.d.ts",
        "import": "./dist/db/pg.js"
      },
      "./enrollment": {
        "types": "./dist/enrollment/index.d.ts",
        "import": "./dist/enrollment/index.js"
      },
      "./spaces": {
        "types": "./dist/spaces/index.d.ts",
        "import": "./dist/spaces/index.js"
      },
      "./network": {
        "types": "./dist/network/index.d.ts",
        "import": "./dist/network/index.js"
      }
    }
  }
}
